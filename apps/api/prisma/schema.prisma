// Prisma schema for Ticketing System

generator client {
  provider      = "prisma-client-js"
  // Must match production OS. "debian-openssl-3.0.x" is for Azure App Service (Linux) and Debian with OpenSSL 3.
  // If you deploy to Windows App Service or another Linux base, add that target or generate on the target machine.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TicketStatus {
  NEW
  TRIAGED
  ASSIGNED
  IN_PROGRESS
  WAITING_ON_REQUESTER
  WAITING_ON_VENDOR
  RESOLVED
  CLOSED
  REOPENED
}

/// Why a closed ticket closed (card 1.2). Set on CLOSED, cleared on REOPENED.
enum TicketCloseReason {
  REQUESTER_CONFIRMED
  REQUESTER_CANCELLED
  AGENT_CLOSED
  AUTO_CLOSED
}

enum TicketPriority {
  SEV1
  SEV2
  SEV3
  SEV4
}

enum TicketChannel {
  PORTAL
  EMAIL
  API
}

/// How two tickets relate (card 1.6).
///
/// RELATED is symmetric; DUPLICATE_OF and PARENT_OF are not. Only ONE row is
/// ever stored per relationship and the inverse is derived for display -
/// storing both directions doubles the rows and lets them disagree.
enum TicketLinkType {
  RELATED
  DUPLICATE_OF
  PARENT_OF
}

enum MessageType {
  PUBLIC
  INTERNAL
}

enum TagSource {
  AI
  MANUAL
}

enum TeamRole {
  AGENT
  LEAD
  ADMIN
}

enum TeamAssignmentStrategy {
  QUEUE_ONLY
  ROUND_ROBIN
}

enum UserRole {
  EMPLOYEE
  AGENT
  LEAD
  TEAM_ADMIN
  OWNER
}

enum AccessLevel {
  READ
  WRITE
}

enum NotificationChannel {
  EMAIL
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum AttachmentScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
}

enum IdempotencyState {
  IN_PROGRESS
  COMPLETED
}

enum NotificationType {
  /// A new ticket arrived and somebody on the assigned team should pick it up
  /// (card 1.42). NOT the same as TICKET_UPDATED, which the automation engine
  /// raises - the notification centre maps type to icon, so they cannot share.
  TICKET_CREATED
  TICKET_ASSIGNED
  TICKET_UPDATED
  NEW_MESSAGE
  TICKET_MENTIONED
  SLA_AT_RISK
  SLA_BREACHED
  TICKET_RESOLVED
  TICKET_TRANSFERRED
  FOLLOW_UP_DUE
}

enum SlaNotifyRole {
  AGENT
  LEAD
  MANAGER
  OWNER
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  /// The Entra directory object id (the `oid` token claim), when we have seen a
  /// token for this human. Nullable: every pre-existing row starts without one,
  /// and an inbound-only requester who never signs in never gets one. Unique so
  /// two rows cannot claim the same directory object.
  entraObjectId String?   @unique
  displayName   String
  department    String?
  location      String?
  graphProfile  Json?
  role          UserRole  @default(EMPLOYEE)
  primaryTeamId String? // for TEAM_ADMIN: the team they administer
  isActive      Boolean   @default(true)
  deactivatedAt DateTime?
  /// Whether this person is currently taking auto-assigned work (card 2.2).
  ///
  /// ⚠️ DISTINCT FROM `isActive`, and the difference matters. `isActive`
  /// false means the account is deactivated, and `users.service.ts` deletes the
  /// person's TeamMember rows at that moment, so they are already out of every
  /// rotation. `isAvailable` false means a working account on leave: the
  /// memberships stay, the sidebar still shows them, and only auto-assignment
  /// skips them.
  isAvailable   Boolean   @default(true)
  /// When an absence ends, or null for "away indefinitely".
  ///
  /// A return date is not a promise the scheduler has to keep: the availability
  /// check treats a past `awayUntil` as back, so if the job does not run the
  /// person returns to rotation anyway. The job (`availability-return`) exists
  /// to flip the stored flag so the UI agrees with the behaviour.
  awayUntil     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  teamMemberships         TeamMember[]
  primaryTeam             Team?                @relation("UserPrimaryTeam", fields: [primaryTeamId], references: [id])
  requestedTickets        Ticket[]             @relation("TicketRequester")
  assignedTickets         Ticket[]             @relation("TicketAssignee")
  messages                TicketMessage[]
  events                  TicketEvent[]
  ticketFollows           TicketFollower[]
  notificationOutbox      NotificationOutbox[]
  attachments             Attachment[]
  lastAssignedTeams       Team[]               @relation("TeamLastAssigned")
  notifications           Notification[]
  actedNotifications      Notification[]       @relation("NotificationActor")
  savedViews              SavedView[]
  cannedResponses         CannedResponse[]
  automationRulesCreated  AutomationRule[]
  routingRulesAssigned    RoutingRule[]        @relation("RoutingRuleAssignee")
  slaPolicyConfigsCreated SlaPolicyConfig[]    @relation("SlaPolicyConfigCreatedBy")
  adminAuditEvents        AdminAuditEvent[]    @relation("AdminAuditEventCreatedBy")
  kbArticles              KbArticle[]          @relation("KbArticleAuthor")
  emailAliases            UserEmailAlias[]
  ticketLinksCreated      TicketLink[]         @relation("TicketLinkCreatedBy")
  messagesRedacted        TicketMessage[]      @relation("TicketMessageRedactedBy")

  // TEAM_ADMIN user listings filter users by primaryTeamId
  // (users.service.ts getUserListScope) — index avoids a full User scan.
  @@index([primaryTeamId])
  // Declares the index already created by migration 20260521_user_is_active.
  // Without this line schema drifts from the DB and `migrate dev` would try to
  // drop it. The index already exists in all environments — no new migration.
  @@index([isActive])
}

model Team {
  id                  String                 @id @default(uuid())
  name                String
  slug                String                 @unique
  description         String?
  assignmentStrategy  TeamAssignmentStrategy @default(QUEUE_ONLY)
  lastAssignedUserId  String?
  isActive            Boolean                @default(true)
  /// Departments handling PHI or otherwise sensitive traffic. Drives the higher
  /// AI confidence bar before a ticket is auto-routed here instead of going to
  /// human triage. Configuration, not code — see AGENTS.md §10.
  isSensitive         Boolean                @default(false)
  /// Per-department override of the AI auto-routing confidence threshold (0-1).
  /// Null falls back to AI_SENSITIVE_DEPT_THRESHOLD when isSensitive, else
  /// AI_CONFIDENCE_THRESHOLD.
  confidenceThreshold Float?
  /// Built-in sidebar presets this team has switched off (card 1.53).
  ///
  /// Ids from `SAVED_VIEWS` in `apps/web/src/components/shell/saved-views.ts`,
  /// which are CODE CONSTANTS rather than rows - so an id here whose preset has
  /// since been renamed or removed is ignored silently. Never a ghost entry,
  /// never a crash.
  ///
  /// Team-admin-only by design: a member cannot opt back in. Two mechanisms
  /// answering "is this row visible" is the drift that produced cards 1.36,
  /// 1.38, 1.47 and 1.50, so there is deliberately no personal override.
  hiddenPresetIds     String[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  members              TeamMember[]
  primaryTeamUsers     User[]                   @relation("UserPrimaryTeam")
  tickets              Ticket[]
  ticketAccess         TicketAccess[]
  routingRules         RoutingRule[]
  slaPolicyAssignments SlaPolicyAssignment[]
  businessHoursSetting SlaBusinessHoursSetting?
  lastAssignedUser     User?                    @relation("TeamLastAssigned", fields: [lastAssignedUserId], references: [id])
  savedViews           SavedView[]
  cannedResponses      CannedResponse[]
  customFields         CustomField[]
  automationRules      AutomationRule[]
  adminAuditEvents     AdminAuditEvent[]        @relation("AdminAuditEventTeam")
}

model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  parentId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent       Category?     @relation("CategoryParent", fields: [parentId], references: [id])
  children     Category[]    @relation("CategoryParent")
  tickets      Ticket[]
  customFields CustomField[]

  @@index([parentId])
}

enum KbArticleStatus {
  DRAFT
  PUBLISHED
}

model KbCategory {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  articles KbArticle[]

  @@index([slug])
}

model KbArticle {
  id         String          @id @default(uuid())
  title      String          @db.VarChar(255)
  slug       String          @unique
  summary    String?         @db.VarChar(500)
  content    String          @db.Text
  status     KbArticleStatus @default(DRAFT)
  isInternal Boolean         @default(false)
  viewCount  Int             @default(0)
  deletedAt  DateTime?
  categoryId String?
  authorId   String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  category KbCategory? @relation(fields: [categoryId], references: [id])
  author   User?       @relation("KbArticleAuthor", fields: [authorId], references: [id])

  @@index([categoryId])
  @@index([status])
  @@index([slug])
  @@index([deletedAt])
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  role      TeamRole @default(AGENT)
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
  @@index([userId])
}

model Ticket {
  id                 String             @id @default(uuid())
  number             Int                @unique @default(autoincrement())
  displayId          String?            @unique
  subject            String             @db.VarChar(200)
  description        String             @db.Text
  status             TicketStatus       @default(NEW)
  priority           TicketPriority     @default(SEV3)
  channel            TicketChannel      @default(PORTAL)
  requesterId        String
  assignedTeamId     String?
  assigneeId         String?
  categoryId         String?
  dueAt              DateTime?
  /// "Remind me Friday" (card 1.10). Cleared by the scheduler when it fires, so
  /// a reminder cannot arrive twice.
  followUpAt         DateTime?
  firstResponseDueAt DateTime?
  firstResponseAt    DateTime?
  slaPausedAt        DateTime?
  resolvedAt         DateTime?
  closedAt           DateTime?
  closeReason        TicketCloseReason?
  completedAt        DateTime?
  deletedAt          DateTime?
  deletedById        String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  requester            User                  @relation("TicketRequester", fields: [requesterId], references: [id])
  assignedTeam         Team?                 @relation(fields: [assignedTeamId], references: [id], onDelete: Restrict)
  assignee             User?                 @relation("TicketAssignee", fields: [assigneeId], references: [id])
  category             Category?             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  messages             TicketMessage[]
  events               TicketEvent[]
  accessGrants         TicketAccess[]
  followers            TicketFollower[]
  attachments          Attachment[]
  inboundEmailReceipts InboundEmailReceipt[]
  emailThread          TicketEmailThread?
  notificationOutbox   NotificationOutbox[]
  slaInstance          SlaInstance?
  notifications        Notification[]
  customFieldValues    CustomFieldValue[]
  automationExecutions AutomationExecution[]
  tags                 TicketTag[]
  linksFrom            TicketLink[]          @relation("TicketLinkFrom")
  linksTo              TicketLink[]          @relation("TicketLinkTo")

  /// The scheduler sweeps for due follow-ups on every tick (card 1.10).
  @@index([followUpAt])
  @@index([status, updatedAt])
  @@index([assignedTeamId, status, updatedAt])
  @@index([assigneeId, status, updatedAt])
  @@index([requesterId, createdAt])
  @@index([dueAt])
  @@index([completedAt])
  @@index([deletedAt])
  @@index([categoryId])
  @@index([priority])
  @@index([createdAt])
  @@index([firstResponseDueAt])
}

model TicketEmailThread {
  id                    String    @id @default(uuid())
  ticketId              String    @unique
  replyToken            String    @unique @db.VarChar(128)
  canonicalSubject      String    @db.VarChar(200)
  rootInboundMessageId  String?   @db.VarChar(255)
  lastInboundMessageId  String?   @db.VarChar(255)
  lastInboundAt         DateTime?
  lastOutboundMessageId String?   @db.VarChar(255)
  lastOutboundAt        DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([replyToken])
  @@index([lastInboundAt])
  @@index([lastOutboundAt])
}

model InboundEmailReceipt {
  id        String   @id @default(uuid())
  messageId String   @unique
  fromEmail String
  subject   String
  ticketId  String?
  threaded  Boolean?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticket Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([createdAt])
}

model CustomField {
  id         String    @id @default(uuid())
  name       String
  fieldType  String // TEXT, TEXTAREA, NUMBER, DROPDOWN, MULTISELECT, DATE, CHECKBOX, USER
  options    Json? // For dropdown/multiselect: [{value, label}]
  isRequired Boolean   @default(false)
  teamId     String?
  team       Team?     @relation(fields: [teamId], references: [id])
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  values CustomFieldValue[]

  @@index([teamId])
  @@index([categoryId])
}

model CustomFieldValue {
  id            String      @id @default(uuid())
  ticketId      String
  ticket        Ticket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  customFieldId String
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  value         String?     @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([ticketId, customFieldId])
  @@index([ticketId])
  @@index([customFieldId])
}

model TicketMessage {
  id        String      @id @default(uuid())
  ticketId  String
  authorId  String
  type      MessageType @default(PUBLIC)
  body      String      @db.Text
  createdAt DateTime    @default(now())

  /// Card 1.11. Set when the message has been redacted; `body` is OVERWRITTEN
  /// at that moment with "[message removed by <name>]" and the original text is
  /// not kept anywhere. See docs and the redact endpoint for why: a healthcare
  /// desk redacts precisely because something ended up in the wrong place, and
  /// preserving it in a TicketEvent would move the PHI rather than remove it.
  redactedAt   DateTime?
  redactedById String?

  ticket     Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author     User   @relation(fields: [authorId], references: [id])
  redactedBy User?  @relation("TicketMessageRedactedBy", fields: [redactedById], references: [id])

  @@index([ticketId, createdAt])
  @@index([authorId])
  @@index([redactedById])
}

model TicketEvent {
  id          String   @id @default(uuid())
  ticketId    String
  type        String
  payload     Json?
  createdAt   DateTime @default(now())
  createdById String?

  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdBy User?  @relation(fields: [createdById], references: [id])

  @@index([ticketId, createdAt])
  @@index([type])
  @@index([createdById])
}

/// A relationship between two tickets (card 1.6).
///
/// One row per relationship, direction carried by from -> to. The composite
/// unique stops the same pair being linked twice with the same type; a pair may
/// still carry two different types, which is legitimate (RELATED and PARENT_OF
/// say different things).
model TicketLink {
  id           String         @id @default(uuid())
  fromTicketId String
  toTicketId   String
  type         TicketLinkType
  /// Nullable, like TicketEvent.createdById: a link outlives the account that
  /// made it, and card 1.30 established that accounts do get merged away.
  createdById  String?
  createdAt    DateTime       @default(now())

  fromTicket Ticket @relation("TicketLinkFrom", fields: [fromTicketId], references: [id], onDelete: Cascade)
  toTicket   Ticket @relation("TicketLinkTo", fields: [toTicketId], references: [id], onDelete: Cascade)
  createdBy  User?  @relation("TicketLinkCreatedBy", fields: [createdById], references: [id])

  @@unique([fromTicketId, toTicketId, type])
  @@index([fromTicketId])
  @@index([toTicketId])
  @@index([createdById])
}

model AdminAuditEvent {
  id          String   @id @default(uuid())
  type        String
  payload     Json?
  teamId      String?
  createdById String?
  // Snapshot fields (8.1 fix): preserve attribution even if user/team is deleted
  actorEmail  String?
  actorName   String?
  teamName    String?
  createdAt   DateTime @default(now())

  team      Team? @relation("AdminAuditEventTeam", fields: [teamId], references: [id], onDelete: SetNull)
  createdBy User? @relation("AdminAuditEventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([type])
  @@index([teamId])
  @@index([createdById])
}

model TicketAccess {
  id          String      @id @default(uuid())
  ticketId    String
  teamId      String
  accessLevel AccessLevel @default(READ)
  createdAt   DateTime    @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id])

  @@unique([ticketId, teamId])
}

model RoutingRule {
  id         String   @id @default(uuid())
  name       String
  keywords   String[]
  teamId     String
  assigneeId String?
  priority   Int      @default(100)
  isActive   Boolean  @default(true)
  // Expanded rule engine. `keywords`/`teamId`/`assigneeId` are kept in sync
  // (mirrored from conditions/actions) so the legacy executor stays valid.
  matchType  String   @default("ALL") // "ALL" (AND) | "ANY" (OR)
  conditions Json     @default("[]") // [{ field, op, value }]
  actions    Json     @default("[]") // [{ type, value }]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  team     Team  @relation(fields: [teamId], references: [id])
  assignee User? @relation("RoutingRuleAssignee", fields: [assigneeId], references: [id])

  @@index([teamId])
  @@index([assigneeId])
}

model SlaPolicyConfig {
  id                     String          @id @default(uuid())
  name                   String
  description            String?
  isDefault              Boolean         @default(false)
  enabled                Boolean         @default(true)
  businessHoursOnly      Boolean         @default(true)
  escalationEnabled      Boolean         @default(true)
  escalationAfterPercent Int             @default(80)
  breachNotifyRoles      SlaNotifyRole[] @default([AGENT, LEAD])
  createdById            String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  createdBy   User?                   @relation("SlaPolicyConfigCreatedBy", fields: [createdById], references: [id])
  targets     SlaPolicyConfigTarget[]
  assignments SlaPolicyAssignment[]
  instances   SlaInstance[]           @relation("SlaInstancePolicyConfig")

  @@index([isDefault])
  @@index([enabled])
}

model SlaPolicyConfigTarget {
  id                 String         @id @default(uuid())
  policyConfigId     String
  priority           TicketPriority
  firstResponseHours Int
  resolutionHours    Int
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  policy SlaPolicyConfig @relation(fields: [policyConfigId], references: [id], onDelete: Cascade)

  @@unique([policyConfigId, priority])
}

model SlaPolicyAssignment {
  id             String   @id @default(uuid())
  policyConfigId String
  teamId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  policy SlaPolicyConfig @relation(fields: [policyConfigId], references: [id], onDelete: Cascade)
  team   Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId])
  @@unique([policyConfigId, teamId])
}

model SlaBusinessHoursSetting {
  id        String   @id @default("global")
  /// Null is the organisation default calendar (the legacy "global" row). A team
  /// row overrides it for that team only — configuration, not code.
  teamId    String?  @unique
  timezone  String   @default("UTC")
  schedule  Json
  holidays  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model SlaInstance {
  id                            String         @id @default(uuid())
  ticketId                      String         @unique
  policyConfigId                String?
  priority                      TicketPriority
  firstResponseDueAt            DateTime?
  resolutionDueAt               DateTime?
  pausedAt                      DateTime?
  nextDueAt                     DateTime?
  firstResponseAtRiskNotifiedAt DateTime?
  resolutionAtRiskNotifiedAt    DateTime?
  firstResponseBreachedAt       DateTime?
  resolutionBreachedAt          DateTime?
  createdAt                     DateTime       @default(now())
  updatedAt                     DateTime       @updatedAt

  ticket       Ticket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  policyConfig SlaPolicyConfig? @relation("SlaInstancePolicyConfig", fields: [policyConfigId], references: [id])

  @@index([nextDueAt])
  @@index([policyConfigId])
  @@index([resolutionDueAt])
}

model TicketFollower {
  id        String   @id @default(uuid())
  ticketId  String
  userId    String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([ticketId, userId])
  @@index([ticketId])
  @@index([userId])
}

model Tag {
  id          String   @id @default(uuid())
  name        String   @unique // normalized: trim + lowercase
  color       String?
  createdAt   DateTime @default(now())
  createdById String?

  ticketTags TicketTag[]

  @@index([name])
}

model TicketTag {
  ticketId    String
  tagId       String
  source      TagSource @default(MANUAL)
  createdAt   DateTime  @default(now())
  createdById String?

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([ticketId, tagId])
  @@index([tagId])
  @@index([ticketId])
}

/// The Graph delta cursor for one polled mailbox (card 1.24).
///
/// ⚠️ THE WHOLE REASON THIS CARD POLLS RATHER THAN USING A WEBHOOK. The delta
/// link is a durable cursor: if the app is down for a deploy or an outage, the
/// next poll collects everything that arrived meanwhile. Holding it in memory
/// would silently lose every message that arrived during a restart - which is
/// the exact failure a push subscription has, and the reason polling was
/// chosen over one.
///
/// One row per mailbox address. There is expected to be exactly one, but the
/// address is the key rather than a singleton flag so that pointing the worker
/// at a different mailbox starts a fresh cursor instead of resuming somebody
/// else's.
model InboundMailboxCursor {
  id        String   @id @default(uuid())
  /// The mailbox this cursor belongs to, lower-cased.
  mailbox   String   @unique
  /// Opaque Graph `@odata.deltaLink`. Null means "never synced": the next poll
  /// starts a new delta and takes whatever the initial page returns.
  deltaLink String?
  /// When a poll last completed, successfully or not. Operations reads this.
  lastSyncedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NotificationOutbox {
  id        String              @id @default(uuid())
  channel   NotificationChannel @default(EMAIL)
  status    OutboxStatus        @default(PENDING)
  eventType String
  toEmail   String
  toUserId  String?
  ticketId  String?
  subject   String
  body      String
  payload   Json?
  attempts  Int                 @default(0)
  lastError String?
  sentAt    DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  toUser User?   @relation(fields: [toUserId], references: [id])
  ticket Ticket? @relation(fields: [ticketId], references: [id])

  @@index([status, createdAt])
  @@index([toEmail])
  @@index([ticketId])
}

/// Addresses that must not be emailed again, and why. Card 1.23.
///
/// `kind` is a plain string the way CustomField.fieldType is, rather than a new
/// enum: adding an enum VALUE later needs its own migration that cannot be used
/// in the same transaction, and this list may well grow a third kind.
model EmailSuppression {
  id           String   @id @default(uuid())
  /// Always stored lowercased; the service lowercases before reading or writing.
  address      String   @unique
  /// HARD (suppressed immediately) or SOFT (suppressed once failureCount hits 5).
  kind         String
  failureCount Int      @default(1)
  lastReason   String?
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([kind])
}

model Attachment {
  id            String               @id @default(uuid())
  ticketId      String
  uploadedById  String
  fileName      String
  contentType   String
  sizeBytes     Int
  storageKey    String
  scanStatus    AttachmentScanStatus @default(PENDING)
  scanCheckedAt DateTime?
  scanError     String?
  createdAt     DateTime             @default(now())

  ticket     Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploadedBy User   @relation(fields: [uploadedById], references: [id])

  @@index([ticketId])
  @@index([ticketId, createdAt])
  @@index([uploadedById])
  @@index([scanStatus])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  ticketId  String?
  actorId   String?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user   User    @relation(fields: [userId], references: [id])
  ticket Ticket? @relation(fields: [ticketId], references: [id])
  actor  User?   @relation("NotificationActor", fields: [actorId], references: [id])

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([ticketId])
}

model IdempotencyRequest {
  id           String           @id @default(uuid())
  key          String
  method       String
  route        String
  actorId      String
  requestHash  String
  state        IdempotencyState @default(IN_PROGRESS)
  statusCode   Int?
  responseBody Json?
  expiresAt    DateTime
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([key, method, route, actorId])
  @@index([expiresAt])
  @@index([state, updatedAt])
}

model SavedView {
  id        String   @id @default(uuid())
  name      String
  filters   Json
  /// Which kind of view this is: "tickets" or "reports" (card 1.60).
  ///
  /// A REAL COLUMN, not a key inside `filters`, and not an expression index
  /// over the JSON. `viewType` was only ever written on report views
  /// (ReportsPage), so `filters->>'viewType'` is NULL for every ticket view -
  /// and a unique index treats NULLs as distinct, so it would not have
  /// constrained ticket views at all. COALESCE would work and would bury the
  /// default inside an index expression where nobody would find it.
  ///
  /// It REPLACES the JSON key rather than sitting beside it. Migration 61
  /// strips `viewType` out of `filters`, because two copies of one
  /// discriminator is the drift behind cards 1.36, 1.38, 1.47 and 1.50 - the
  /// objection card 1.53's implementer raised, and they were right.
  viewType  String   @default("tickets")
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  teamId    String?
  team      Team?    @relation(fields: [teamId], references: [id])
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([teamId])
}

model CannedResponse {
  id        String   @id @default(uuid())
  name      String
  content   String   @db.Text
  /// What applying this template DOES, beyond pasting its text (card 1.7).
  ///
  /// Validated with AutomationActionDto - the same class the rule engine uses,
  /// so there is one action shape - but a macro may only carry the subset in
  /// MACRO_ALLOWED_ACTIONS. Notably NOT send_email, notify_requester or
  /// notify_team_lead: card 1.42 deleted most email to stop noise, and a macro
  /// that sends email would put it back through a side door.
  actions   Json     @default("[]")
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  teamId    String?
  team      Team?    @relation(fields: [teamId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([teamId])
}

model AutomationRule {
  id          String   @id @default(uuid())
  name        String
  description String?
  trigger     String // TICKET_CREATED, STATUS_CHANGED, SLA_APPROACHING, SLA_BREACHED
  conditions  Json // Array of condition objects: { field, operator, value } or { and/or: [...] }
  actions     Json // Array of action objects: { type, ...params }
  isActive    Boolean  @default(true)
  priority    Int      @default(0) // Lower = run first
  teamId      String?
  team        Team?    @relation(fields: [teamId], references: [id])
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  executions AutomationExecution[]

  @@index([trigger])
  @@index([teamId])
  @@index([isActive])
}

model AutomationExecution {
  id         String         @id @default(uuid())
  ruleId     String
  rule       AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  ticketId   String
  ticket     Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  trigger    String // TICKET_CREATED, STATUS_CHANGED, SLA_APPROACHING, SLA_BREACHED — used for de-dupe
  success    Boolean
  error      String?        @db.Text
  executedAt DateTime       @default(now())

  @@index([ruleId])
  @@index([ticketId])
  @@index([ruleId, ticketId, trigger])
  @@index([executedAt])
}

// ─── AI Observability ────────────────────────────────────────────────────────
// ADR-001 justifies the 6-step pipeline on observability, testability and
// tunability. Storing traces in a TicketEvent JSON payload satisfies none of
// those at scale — routing accuracy, precision/recall and a confusion matrix
// cannot be computed from JSON blobs. These tables make the Phase-1 >=85%
// routing-accuracy gate measurable. All writes are fire-and-forget and must
// never block or fail the request path.

enum AiStepStatus {
  SUCCESS
  ERROR
}

enum AiRoutingMethod {
  AI
  RULE
  MANUAL
}

/// One row per pipeline step per run.
model AiInferenceLog {
  id            String       @id @default(uuid())
  correlationId String
  ticketId      String?
  step          Int
  agentName     String
  model         String?
  latencyMs     Int
  status        AiStepStatus
  /// Redacted before write for sensitive departments — never store raw PHI.
  rawOutput     String?      @db.Text
  parsed        Json?
  error         String?      @db.Text
  redacted      Boolean      @default(false)
  createdAt     DateTime     @default(now())

  @@index([createdAt])
  @@index([correlationId])
  @@index([ticketId])
}

/// One row per routing decision, for accuracy scoring against ground truth.
model RoutingDecisionLog {
  id              String          @id @default(uuid())
  correlationId   String
  ticketId        String?
  predictedTeamId String?
  confidence      Float
  thresholdUsed   Float
  method          AiRoutingMethod
  matchedRuleId   String?
  /// Runner-up departments with their confidences, for confusion-matrix work.
  alternatives    Json?
  /// False when the gate sent it to human triage instead of auto-routing.
  accepted        Boolean
  createdAt       DateTime        @default(now())

  @@index([createdAt])
  @@index([predictedTeamId, createdAt])
  @@index([ticketId])
}

/// Agent overrides of an AI decision — the training signal for the reviewed
/// promotion lifecycle. Append-only.
model CorrectionLog {
  id            String   @id @default(uuid())
  ticketId      String
  field         String
  fromValue     String?
  toValue       String?
  correctedById String
  reason        String?  @db.Text
  createdAt     DateTime @default(now())

  @@index([ticketId])
  @@index([field, createdAt])
}

/// Every address the directory has told us belongs to one human.
///
/// Recorded from the token at login - `preferred_username`, `upn` and `email` -
/// so it is GIVEN to us, never inferred. Nothing in this table comes from
/// comparing the shape of two addresses; that is the duplicate DETECTION path
/// and it is for suspicion only.
///
/// `email` is unique across the whole table on purpose: if two humans could both
/// claim the same alternate address, resolution becomes ambiguous and the intake
/// path would silently pick one. A key inside `User.graphProfile` could not carry
/// that constraint, which is why this is a table.
model UserEmailAlias {
  id        String   @id @default(uuid())
  userId    String
  email     String   @unique
  /// Which claim it arrived on, kept so a bad mapping can be traced back.
  source    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
